# Copy this file to .env and fill in the values. .env is git-ignored.

# --- OpenSubtitles (https://www.opensubtitles.com/consumers) ---
# API key of your registered API consumer.
OPENSUBTITLES_API_KEY=
# Your opensubtitles.com account. Logging in is what gives you the VIP download quota (1000/day).
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
# Must name your app, e.g. "subtune v0.1". OpenSubtitles may block a missing or generic User-Agent.
OPENSUBTITLES_USER_AGENT=subtune v0.1
# Requests per second. 5 is the default API limit; raise to 50 only if your API key is on a paid plan.
OPENSUBTITLES_RATE_LIMIT=5

# --- Hugging Face ---
# Not needed for training: every offered model is public and ungated (a token only raises download
# rate limits). Needed with WRITE access to upload fine-tuned GGUFs to private repos ("Upload ... and
# deploy" on the Train tab).
HF_TOKEN=
# HF user or organisation that owns the uploaded repos (default: the token's user).
# SUBTUNE_HF_NAMESPACE=

# --- llm-model-manager (https://github.com/kevin000001505/llm-model-manager) ---
# Where to deploy uploaded fine-tunes; they are then served by its llama-swap (port 8080).
# LLM_MANAGER_URL=http://192.168.1.10:8000
# GPU placement: a GPUS name from the manager's .env (e.g. r9700), or "all".
# LLM_MANAGER_GPU=all
# llama-server parameters for the deployed config (JSON).
# LLM_MANAGER_PARAMS={"c": 4096}
# llama-swap's address, only used for the example call in the model card.
# LLAMA_SWAP_URL=http://192.168.1.10:8080

# --- Modal (cloud GPUs, https://modal.com/settings/tokens) ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Optional ---
# Building the movie list: when the API refuses broad searches, titles are looked up by IMDb id for
# every IMDb movie/series with at least this many votes (default 1000, about 65,000 titles).
# SUBTUNE_IMDB_MIN_VOTES=1000
# Where subtitles, the catalog database, and fine-tuned models are stored.
# SUBTUNE_DATA_DIR=./data
# SUBTUNE_OUTPUT_DIR=./outputs

# --- Docker (optional, read by docker compose) ---
# PyTorch build for the image. Default: ROCm 7.2 for the AMD R9700.
# TORCH_INDEX_URL=https://download.pytorch.org/whl/rocm7.2
# Host port for the web app.
# SUBTUNE_PORT=7860
